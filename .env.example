# NEX-ROVER Server Environment Configuration

# Optional Cloud LLM API Keys for Natural Language Voice & Chat Processing
# The dashboard includes an offline zero-latency rule-based command interpreter by default.
# Supplying an API key enables advanced conversational comprehension via backend proxy.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Default Robot Hardware Endpoints (can also be configured live in the dashboard UI)
ROBOT_ENDPOINT=http://192.168.4.1
CAMERA_STREAM_URL=http://192.168.4.1:81/stream
