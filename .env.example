# NEX-ROVER Server Environment Configuration (Do not commit real secrets)

# 1. Google Gemini AI Vision & Natural Language Configuration
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Optional OpenAI Configuration (Alternative LLM fallback)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# 3. Authenticated PC Backend Relay Configuration
# Runs locally on the operator's PC (e.g. pc_backend/app.py) to bridge commands
# between the cloud-hosted HTTPS dashboard and the local ESP32 rover.
PC_BACKEND_URL=http://127.0.0.1:5000
ROVER_TOKEN=your_secure_rover_secret_token_here

# 4. Default Robot Hardware Endpoints (also configurable live in dashboard Settings modal)
ROBOT_ENDPOINT=http://192.168.4.1
CAMERA_STREAM_URL=http://192.168.4.1:81/stream

# 5. Optional Serverless Deployment Shared Store (Upstash Redis / Vercel KV)
# In multi-instance serverless deployments (e.g. Vercel), in-memory state is isolated between lambda instances.
# Configuring Upstash Redis / Vercel KV REST API enables persistent real-time frame transport between phone (/camera) and laptop dashboard.
# (If omitted, falls back gracefully to OS filesystem shared store & memory cache).
KV_REST_API_URL=https://your-upstash-instance.upstash.io
KV_REST_API_TOKEN=your_upstash_token_here
